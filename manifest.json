{
  "manifest_version": 3,
  "name": "Manualize",
  "version": "2.0.0",
  "description": "Automatically record step-by-step guides from any webpage. Free & offline Tango alternative.",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
